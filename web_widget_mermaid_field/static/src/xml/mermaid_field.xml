<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="web_widget_mermaid_field.MermaidField">
        <div t-att-style="this.containerStyle">
            <pre t-if="this.state.error" class="o_form_field_mermaid_error text-danger" t-out="this.state.error"/>
            <div t-else="" class="o_form_field_mermaid" t-att-style="this.chartStyle" t-out="this.state.svg"/>
        </div>
    </t>

</templates>
