<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.website.sale.stock.notification</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="website_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='allow_out_of_stock_order_setting']/.." position="after">
                <div class="content-group">
                    <div class="row mt16"
                         id="out_of_stock_back_in_stock_message_setting"
                         title="Default for newly created products: let customers subscribe to an email notification when an out-of-stock product is back in stock.">
                        <div class="col-12">
                            <label for="default_out_of_stock_back_in_stock_message" string="Back in Stock Message" class="p-0 col-4 o_light_label"/>
                            <field name="default_out_of_stock_back_in_stock_message" class="w-auto"/>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>

</odoo>
