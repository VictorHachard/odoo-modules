<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="product_template_form_view" model="ir.ui.view">
        <field name="name">product.template.form.inherit.website.sale.stock.notification</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="website_sale.product_template_form_view"/>
        <field name="arch" type="xml">
            <field name="out_of_stock_message" position="after">
                <field name="out_of_stock_back_in_stock_message" invisible="allow_out_of_stock_order"/>
            </field>
        </field>
    </record>

</odoo>
