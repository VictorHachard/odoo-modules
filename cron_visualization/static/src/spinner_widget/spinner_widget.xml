<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- These widget templates are intended for read-only mode only -->

    <t t-name="spinner_widget">
        <span>
            <div t-if="this.isRunning" class="spinner-border spinner-border-sm text-success" role="status" t-att-data-tooltip="this.getSpinnerTitle"/>
            <div t-else="" class="spinner-border spinner-border-sm text-warning" style="animation: none;" role="status" t-att-data-tooltip="this.getSpinnerTitle"/>
        </span>
    </t>

</templates>
