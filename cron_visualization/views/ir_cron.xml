<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="ir_cron_view_form_inherit" model="ir.ui.view">
            <field name="name">ir.cron.view.form.history.inherit</field>
            <field name="model">ir.cron</field>
            <field name="inherit_id" ref="base.ir_cron_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//div[@name='button_box']" position="inside">
                    <button name="open_history" type="object" class="oe_stat_button" icon="history" invisible="cv_history_count == 0">
                        <field name="cv_history_count" widget="statinfo" string="History"/>
                    </button>
                </xpath>
            </field>
        </record>

        <record id="ir_cron_view_search_inherit" model="ir.ui.view">
            <field name="name">ir.cron.view.search.history.inherit</field>
            <field name="model">ir.cron</field>
            <field name="inherit_id" ref="base.ir_cron_view_search"/>
            <field name="arch" type="xml">
                <xpath expr="//filter[@name='all']" position="before">
                    <filter string="Running" name="running" domain="[('cv_is_running', '=', True)]"/>
                    <separator/>
                </xpath>
            </field>
        </record>

        <record id="cv_ir_cron_kanban_view" model="ir.ui.view">
            <field name="name">cv.ir.cron.kanban.view</field>
            <field name="model">ir.cron</field>
            <field name="arch" type="xml">
                <kanban js_class="ir_cron_kanban">
                    <templates>
                        <t t-name="card">
                            <div class="row g-2 align-items-center">
                                <div class="col-12 col-lg-3 d-flex align-items-center gap-2 text-truncate">
                                    <strong class="o_kanban_record_title text-truncate">
                                        <field name="name"/>
                                    </strong>
                                    <field name="cv_is_running" widget="spinner_widget"/>
                                </div>
                                <div class="o_kanban_record_bottom col-12 col-lg-4 small text-muted">
                                    <div>
                                        Next Execution Date: <field name="nextcall"/>
                                        (<field name="cv_next_execution_timer" widget="cron_float_time_day_widget"/>)
                                    </div>
                                    <div>Repeat Every: <field name="interval_number"/> <field name="interval_type"/></div>
                                </div>
                                <div class="col-auto">
                                    <field name="cv_history" widget="cron_history_widget" options="{'detail': True}"/>
                                </div>
                                <div class="col">
                                    <field name="cv_progress_estimated" widget="cron_progressbar_widget" class="d-block"/>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <record id="base.ir_cron_act" model="ir.actions.act_window">
            <field name="view_mode">list,kanban,form,calendar</field>
        </record>

    </data>
</odoo>
