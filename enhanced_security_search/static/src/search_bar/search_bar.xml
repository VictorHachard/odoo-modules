<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-inherit="web.SearchBar.Facets" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('position-absolute')]" position="attributes">
            <attribute name="t-if">!hideCustomFilter</attribute>
        </xpath>

        <!-- Keep the core label and its click handler (guarded in search_bar.js)
             so the group-by sort toggle still works; only drop the signals of
             the domain editor: the pencil overlay, the button role and style. -->
        <xpath expr="//div[hasclass('o_searchview_facet_label')]" position="attributes">
            <attribute name="t-att-role">facet.domain and !hideCustomFilter ? 'button' : 'img'</attribute>
            <attribute name="t-att-class">{
                'text-bg-action': facet.type == 'groupBy',
                'btn': facet.type == 'groupBy' and env.searchModel.canOrderByCount,
                'btn btn-primary': (facet.type == 'field' || facet.type == 'filter') and !hideCustomFilter,
                'text-bg-primary': (facet.type == 'field' || facet.type == 'filter') and hideCustomFilter,
                'btn btn-favourite': facet.type == 'favorite' and !hideCustomFilter,
                'text-bg-favourite': facet.type == 'favorite' and hideCustomFilter
            }</attribute>
        </xpath>
        <xpath expr="//span[@t-if='facet.domain']" position="attributes">
            <attribute name="t-if">facet.domain and !hideCustomFilter</attribute>
        </xpath>
    </t>

    <t t-inherit="web.SearchBar.QuickSearchItems" t-inherit-mode="extension">
        <xpath expr="//DropdownItem" position="attributes">
            <attribute name="t-if">!hideCustomFilter or !item.isAddCustomFilterButton</attribute>
        </xpath>
    </t>

</templates>
