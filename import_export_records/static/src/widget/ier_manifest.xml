<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t t-name="import_export_records.IerManifestField">
        <t t-set="manifest" t-value="this.manifest"/>
        <div class="ier_manifest_widget" t-if="manifest">
            <table>
                <tr>
                    <th>Export Name</th>
                    <th>Model Name</th>
                    <th>Fields</th>
                </tr>
                <tr t-foreach="manifest.ir_exports" t-as="ir_export" t-key="ir_export_index">
                    <td><t t-out="ir_export.name"/></td>
                    <td><t t-out="ir_export.model_name"/></td>
                    <td>
                        <t t-foreach="ir_export.fields or []" t-as="field" t-key="field_index">
                            <span class="badge ier_badge"><t t-out="field"/></span>
                        </t>
                    </td>
                </tr>
            </table>
        </div>
    </t>

</templates>
